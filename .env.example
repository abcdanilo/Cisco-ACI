# Exemplo; mantenha as credenciais reais somente no .env do servidor.
APIC_URL=https://apic.exemplo.com.br
APIC_USER=
APIC_PASS=
# true: validar TLS; false: não validar; ou caminho do certificado CA.
APIC_VERIFY=true
APIC_TOKEN_TTL_SEC=300
DATA_CACHE_TTL_SEC=60
APIC_PAGE_SIZE=1000
APIC_MAX_RETRY=3
APIC_TIMEOUT_SEC=20
PORT=8000
