# Credenciais são digitadas na tela de login; não configure APIC_USER/APIC_PASS.
APIC_URL=https://apic.exemplo.com.br
# true: validar TLS; false: não validar; ou caminho do certificado CA.
APIC_VERIFY=true
SESSION_IDLE_SECONDS=1800
# true em produção com HTTPS; false somente para o laboratório HTTP local.
SESSION_COOKIE_SECURE=true
DATA_CACHE_TTL_SEC=60
APIC_PAGE_SIZE=1000
APIC_MAX_RETRY=3
APIC_TIMEOUT_SEC=20
PORT=8000
